# dev | test | prod : see README for more info
# Remember to run `docker compose up --build` when changing environment
ENVIRONMENT=dev

# Define the Tomcat server port for your Docker app container
PORT=8080

# WARN: Set your database production database in `application.properties`!

# Local dev database (Local mariadb)
DEV_SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/dev_db

# Local OR cloud test database
TEST_SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/test_db

# User name and password used by Docker to create the database container
DB_USERNAME=root
DB_PASSWORD=pwd

# Azure OAuth2 settings
# Set these values according to your Azure app registration
AZURE_REDIRECT_BASE_URL=http://localhost:8080
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# JWT Token Configuration
SECURITY_JWT_TOKEN_SECRET_ACCESS_KEY=your-secret-access-key-here-change-in-production
SECURITY_JWT_TOKEN_SECRET_REFRESH_KEY=your-secret-refresh-key-here-change-in-production
SECURITY_JWT_TOKEN_ACCESS_TOKEN_LIFETIME=5m
SECURITY_JWT_TOKEN_REFRESH_TOKEN_LIFETIME=30d
# SameSite attribute of the refresh token cookie: Strict when the client application is served
# from the same site as the API (ports do not matter), None for a client on another domain
SECURITY_REFRESH_COOKIE_SAME_SITE=Strict

# Authentication codes configuration
# These codes are sent to the client application after OAuth2 login, to exchange for JWT tokens
SECURITY_AUTHENTICATION_CODES_LIFETIME=5m

# CORS allowed origins (comma-separated): the client applications allowed to call the API, also
# the only allowed redirect targets after an Azure login. Only needed in production, where the
# default (localhost) is refused at startup. Set it in the production environment, not here:
# compose.yml does not forward it to the container.
# CORS_ALLOWED_ORIGINS=https://app1.example.ch,https://app2.example.ch
